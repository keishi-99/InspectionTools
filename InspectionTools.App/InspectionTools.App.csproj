<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InspectionTools.Excel\InspectionTools.Excel.csproj" />
    <ProjectReference Include="..\InspectionTools.Inspection\InspectionTools.Inspection.csproj" />
    <ProjectReference Include="..\InspectionTools.Products\InspectionTools.Products.csproj" />
  </ItemGroup>

  <!-- キー割り当ての設定。実行ファイルのフォルダに置いて使う。自分で編集した内容が、ビルドのたびに上書きされないよう、すでにあるときはコピーしない -->
  <ItemGroup>
    <None Include="keybindings.json" />
  </ItemGroup>

  <Target Name="CopyKeyBindingsIfMissing" AfterTargets="Build">
    <Copy SourceFiles="keybindings.json" DestinationFolder="$(OutDir)" Condition="!Exists('$(OutDir)keybindings.json')" />
  </Target>

  <ItemGroup>
    <!-- 製品の定義は、リポジトリ共通の products フォルダのものを実行ファイルの隣へコピーして使う -->
    <Content Include="..\products\*.json" Link="products\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- 測定器の一覧（VisaAddress.xml）の見本。実際の一覧は、実行ファイルのフォルダに VisaAddress.xml として置く（リポジトリには入れない） -->
    <Content Include="..\VisaAddress.template.xml" Link="VisaAddress.template.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
