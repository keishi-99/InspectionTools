<Window
    x:Class="InspectionTools.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="検査"
    Width="1100"
    Height="720"
    Background="{DynamicResource MaterialDesignPaper}"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    FontSize="14">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  上部: 製品名と台数  -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="{Binding Product}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text="台数" Margin="32,0,8,0" VerticalAlignment="Center" />
            <Button Width="36" Content="－" Command="{Binding DecreaseUnitCountCommand}" />
            <TextBox
                x:Name="UnitCountTextBox"
                Width="48"
                Margin="4,0"
                TextAlignment="Center"
                VerticalAlignment="Center"
                FontSize="18"
                Text="{Binding UnitCountText, UpdateSourceTrigger=PropertyChanged}"
                LostFocus="UnitCountTextBox_LostFocus">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding ApplyUnitCountTextCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Width="36" Content="＋" Command="{Binding IncreaseUnitCountCommand}" />
            <TextBlock Text="{Binding MaxUnitCount, StringFormat=（最大{0}台）}" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!--  検査項目 × 台の表。列は台数に合わせてコードで作る  -->
        <DataGrid
            x:Name="ResultGrid"
            Grid.Row="1"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserSortColumns="False"
            CanUserReorderColumns="False"
            HeadersVisibility="All"
            IsReadOnly="True"
            SelectionMode="Single"
            SelectionUnit="Cell"
            FrozenColumnCount="1"
            GridLinesVisibility="All"
            SelectedCellsChanged="ResultGrid_SelectedCellsChanged" />

        <!--  下部: 現在の項目と入力欄  -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="12" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CurrentUnitText}" FontWeight="Bold" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding CurrentItem.Name}" FontWeight="Bold" />
                    <TextBlock Text="{Binding CurrentRangeText}" Margin="16,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <!--  測定項目・入力項目  -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsValueInput, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBox
                            x:Name="InputTextBox"
                            Width="160"
                            Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                            materialDesign:HintAssist.Hint="値">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding CommitValueCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Margin="8,0,0,0" Padding="16,0" Content="確定" Command="{Binding CommitValueCommand}" />
                    </StackPanel>

                    <!--  確認項目  -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Padding="16,0" Content="合格" Command="{Binding ConfirmOkCommand}" />
                        <Button Margin="8,0,0,0" Padding="16,0" Content="不合格" Command="{Binding ConfirmNgCommand}" />
                    </StackPanel>

                    <!--  作業項目  -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsTask, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Padding="16,0" Content="作業完了" Command="{Binding CompleteTaskCommand}" />
                    </StackPanel>

                    <Button Margin="32,0,0,0" Padding="16,0" Content="前へ" Command="{Binding MovePreviousCommand}" />
                    <Button Margin="8,0,0,0" Padding="16,0" Content="次へ" Command="{Binding MoveNextCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
