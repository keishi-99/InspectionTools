<Window
    x:Class="InspectionTools.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="検査"
    Width="1100"
    Height="720"
    Background="{DynamicResource MaterialDesignPaper}"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    FontSize="14"
    Closing="Window_Closing"
    PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid>
        <!--  メニュー: 製品を選ぶ  -->
        <Grid Margin="24" Visibility="{Binding IsMenuVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="検査する製品を選んでください" FontSize="20" FontWeight="Bold" />
            <!--  配色の切り替え（検査画面にも同じスイッチがある）  -->
            <StackPanel Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="ダークモード" />
                <ToggleButton
                    x:Name="MenuThemeSwitch"
                    Margin="8,0,0,0"
                    Style="{StaticResource MaterialDesignSwitchToggleButton}"
                    Click="ThemeSwitch_Click" />
            </StackPanel>
            <TextBlock
                Grid.Row="1"
                Margin="0,8,0,0"
                Text="{Binding WarningText}"
                Visibility="{Binding HasWarning, Converter={StaticResource BooleanToVisibilityConverter}}"
                TextWrapping="Wrap" />
            <ItemsControl Grid.Row="2" Margin="0,16,0,0" ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Margin="0,0,0,8"
                            Padding="24,12"
                            HorizontalAlignment="Left"
                            HorizontalContentAlignment="Center"
                            Width="150"
                            Height="Auto"
                            FontSize="18"
                            Content="{Binding Name}"
                            Command="{Binding DataContext.SelectProductCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!--  検査画面（選んだ製品の ViewModel を DataContext にする。コードで切り替える）  -->
        <Grid x:Name="InspectionRoot" Margin="12" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  上部: 製品名と台数  -->
        <StackPanel Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Product}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="台数" Margin="32,0,8,0" VerticalAlignment="Center" />
                <Button Width="36" Padding="0" Content="－" Command="{Binding DecreaseUnitCountCommand}" />
                <TextBox
                    x:Name="UnitCountTextBox"
                    Width="48"
                    Margin="4,0"
                    TextAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="18"
                    InputMethod.IsInputMethodEnabled="False"
                    Text="{Binding UnitCountText, UpdateSourceTrigger=PropertyChanged}"
                    LostFocus="UnitCountTextBox_LostFocus">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding ApplyUnitCountTextCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Width="36" Padding="0" Content="＋" Command="{Binding IncreaseUnitCountCommand}" />
                <TextBlock Text="{Binding MaxUnitCount, StringFormat=（最大{0}台）}" Margin="8,0,0,0" VerticalAlignment="Center" />
                <Button Margin="48,0,0,0" Padding="16,0" Content="検査終了" Command="{Binding FinishInspectionCommand}" />
                <Button Margin="24,0,0,0" Padding="16,0" Content="メニューへ戻る" Click="BackToMenuButton_Click" />
            </StackPanel>
            <!--  キーの有効・無効のスイッチ。全体のホットキーは他のソフトのキーを奪うので、必要なときだけ有効にする  -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button
                    Padding="16,0"
                    Content="測定器"
                    Command="{Binding OpenInstrumentSelectionCommand}"
                    Visibility="{Binding HasInstrumentSelection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding InstrumentStatusText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBlock x:Name="GlobalHotkeyLabel" Margin="32,0,0,0" VerticalAlignment="Center" Text="前面ホットキー" />
                <!--  キーは、下部のキー案内と同じ枠で囲む  -->
                <Border
                    x:Name="GlobalHotkeyBadge"
                    Margin="6,0,0,0"
                    Padding="6,1"
                    VerticalAlignment="Center"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="3">
                    <TextBlock x:Name="GlobalHotkeyKeyText" VerticalAlignment="Center" FontFamily="Consolas, Meiryo" />
                </Border>
                <ToggleButton
                    x:Name="GlobalHotkeySwitch"
                    Margin="8,0"
                    Style="{StaticResource MaterialDesignSwitchToggleButton}"
                    Click="GlobalHotkeySwitch_Click" />
                <TextBlock x:Name="GlobalHotkeyState" Width="48" VerticalAlignment="Center" FontWeight="Bold" />
                <TextBlock Margin="32,0,0,0" Text="画面のキー" VerticalAlignment="Center" />
                <ToggleButton
                    x:Name="LocalKeysSwitch"
                    Margin="8,0"
                    IsChecked="True"
                    Style="{StaticResource MaterialDesignSwitchToggleButton}"
                    Click="LocalKeysSwitch_Click" />
                <TextBlock x:Name="LocalKeysState" VerticalAlignment="Center" FontWeight="Bold" />
                <TextBlock Margin="32,0,0,0" VerticalAlignment="Center" Text="ダークモード" />
                <ToggleButton
                    x:Name="InspectionThemeSwitch"
                    Margin="8,0"
                    Style="{StaticResource MaterialDesignSwitchToggleButton}"
                    Click="ThemeSwitch_Click" />
            </StackPanel>
        </StackPanel>

        <!--  検査項目 × 台の表。列は台数に合わせてコードで作る  -->
        <DataGrid
            x:Name="ResultGrid"
            Grid.Row="1"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserSortColumns="False"
            CanUserReorderColumns="False"
            HeadersVisibility="Column"
            IsReadOnly="True"
            MinRowHeight="26"
            RowHeight="26"
            SelectionMode="Single"
            SelectionUnit="Cell"
            FrozenColumnCount="1"
            GridLinesVisibility="All"
            SelectedCellsChanged="ResultGrid_SelectedCellsChanged">
            <!--  いま検査している項目の行は、薄く色を付けて太字にする（マスの合否の色は、そのまま見える）  -->
            <DataGrid.RowStyle>
                <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter Property="Background" Value="#22673AB7" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>

        <!--  下部: 現在の項目と入力欄  -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="12" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CurrentUnitText}" FontWeight="Bold" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding CurrentItem.Name}" FontWeight="Bold" />
                    <TextBlock Text="{Binding CurrentRangeText}" Margin="16,0,0,0" />
                </StackPanel>
                <!--  項目の説明（作業項目の手順など。ある項目だけ出す）  -->
                <TextBlock
                    Margin="0,4,0,0"
                    Text="{Binding CurrentDescription}"
                    TextWrapping="Wrap"
                    Visibility="{Binding HasDescription, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <!--  測定項目・入力項目  -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsValueInput, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBox
                            x:Name="InputTextBox"
                            Width="160"
                            InputMethod.IsInputMethodEnabled="False"
                            Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                            materialDesign:HintAssist.Hint="値" />
                        <Button
                            Margin="8,0,0,0"
                            Padding="16,0"
                            Content="値を取得"
                            Command="{Binding AcquireValueCommand}"
                            IsEnabled="{Binding CanAcquire}"
                            Visibility="{Binding HasAcquisition, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button Margin="8,0,0,0" Padding="16,0" Content="確定" Command="{Binding CommitValueCommand}" />
                    </StackPanel>

                    <!--  確認項目  -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Padding="16,0" Content="合格" Command="{Binding ConfirmOkCommand}" />
                        <Button Margin="8,0,0,0" Padding="16,0" Content="不合格" Command="{Binding ConfirmNgCommand}" />
                    </StackPanel>

                    <!--  作業項目  -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsTask, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Padding="16,0" Content="作業完了" Command="{Binding CompleteTaskCommand}" />
                    </StackPanel>

                    <Button Margin="32,0,0,0" Padding="16,0" Content="前へ" Command="{Binding MovePreviousCommand}" />
                    <Button Margin="8,0,0,0" Padding="16,0" Content="次へ" Command="{Binding MoveNextCommand}" />
                    <Button
                        Margin="32,0,0,0"
                        Padding="16,0"
                        Content="設定を再適用"
                        Command="{Binding ReapplyInstrumentCommand}"
                        IsEnabled="{Binding CanReapplyInstrument}"
                        Visibility="{Binding HasInstrumentSelection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="{Binding DcsElapsedText}" Margin="24,0,0,0" VerticalAlignment="Center" FontSize="18" />
                </StackPanel>
                <!--  キーの案内（設定ファイルで割り当てを変えると、ここも変わる）  -->
                <TextBlock x:Name="KeyHintDisabledText" Margin="0,8,0,0" Opacity="0.6" Visibility="Collapsed" />
                <ItemsControl x:Name="KeyHintItems" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,2,24,2" Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <!--  いまの項目で使えない操作は、薄く出す  -->
                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                <Setter Property="Opacity" Value="0.35" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock VerticalAlignment="Center" Opacity="0.8" Text="{Binding Label}" />
                                <ItemsControl ItemsSource="{Binding Keys}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!--  キーは、旧アプリのヘルプと同じく、等幅の文字を角丸の枠で囲む。記号1文字のキーは大きく太く出す  -->
                                            <Border
                                                Margin="6,0,0,0"
                                                Padding="6,1"
                                                BorderBrush="Gray"
                                                BorderThickness="1"
                                                CornerRadius="3">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontFamily="Consolas, Meiryo"
                                                    Text="{Binding Text}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <!--  通常の大きさは、ここに書く（要素に直接書くと、下のトリガーの大きさより優先されてしまう）  -->
                                                            <Setter Property="FontSize" Value="13" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSymbol}" Value="True">
                                                                    <Setter Property="FontSize" Value="17" />
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!--  測定器と通信している間は、画面を覆ってマウス操作を止める（通信が重なると、コマンドが混ざるため）  -->
        <Grid
            Grid.RowSpan="3"
            Background="{DynamicResource BusyOverlayBrush}"
            Visibility="{Binding IsInstrumentBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar
                    Width="48"
                    Height="48"
                    IsIndeterminate="True"
                    Style="{StaticResource MaterialDesignCircularProgressBar}"
                    Value="0" />
                <TextBlock Margin="0,8,0,0" Text="測定器と通信中…" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
        </Grid>
    </Grid>
</Window>
